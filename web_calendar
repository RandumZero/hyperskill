from flask import Flask, abort, request
from flask_restful import Api, Resource, reqparse, inputs, fields, marshal_with
from flask_sqlalchemy import SQLAlchemy
import sys, datetime

app = Flask(__name__)
api = Api(app)
parser = reqparse.RequestParser()
get_parser = reqparse.RequestParser()

app.config['SQLALCHEMY_DATABASE_URI'] = 'sqlite:///name.db'

db = SQLAlchemy(app)

class CalEntry(db.Model):
    __tablename__ = 'calendar_entry'
    id = db.Column(db.Integer, primary_key=True)
    event = db.Column(db.String(80), nullable=False)
    date = db.Column(db.Date, nullable=False)

with app.app_context():
    db.create_all()

class HelloWorld(Resource):
    def get(self):
        return {'hello': 'world'}

class Events(Resource):
    def get(self):
        entries = CalEntry.query.filter(CalEntry.date == datetime.date.today()).all()
        return [{
            "id": entry.id,
            "event": entry.event,
            "date": str(entry.date)
        } for entry in entries]

resource_fields = {
    'id': fields.Integer,
    'event': fields.String,
    'date': fields.String
}

class EventByID(Resource):
    @marshal_with(resource_fields)
    def get(self, event_id):
        event = CalEntry.query.filter(CalEntry.id == event_id).first()
        if event is None:
            abort(404, "The event doesn't exist!")
        return {
            "id": event.id,
            "event": event.event,
            "date": event.date
        }, 200

    def delete(self, event_id):
        event = CalEntry.query.filter(CalEntry.id == event_id).first()
        if event:
            db.session.delete(event)
            db.session.commit()
            return {
                "message": "The event has been deleted!"
            }, 200
        else:
            return {
                "message": "The event doesn't exist!"
            }, 404

class HelloWorldResource(Resource):
    def post(self):
        args = parser.parse_args()
        recent_entry = (CalEntry(event=args['event'], date=args['date']))
        db.session.add(recent_entry)
        db.session.commit()
        return {
            "message": "The event has been added!",
            "event": args['event'],
            "date": str(args['date'].date())
        }, 200

    def get(self):
        args = get_parser.parse_args()
        if args['start_time'] is not None and args['end_time'] is not None:
            entries = CalEntry.query.filter(
                CalEntry.date >= args['start_time'],
                CalEntry.date <= args['end_time']
            ).all()
            return [{
                "id": entry.id,
                "event": entry.event,
                "date": str(entry.date)
            } for entry in entries]
        else:
            entries = CalEntry.query.all()
            return [{
                "id": entry.id,
                "event": entry.event,
                "date": str(entry.date)
            } for entry in entries]


parser.add_argument(
    'date',
    type=inputs.date,
    help="The event date with the correct format is required! The correct format is YYYY-MM-DD!",
    required=True
)

get_parser.add_argument(
    'start_time',
    type=inputs.date,
    location='args', #<--- forces code to check url for args
    help="The event date with the correct format is required! The correct format is YYYY-MM-DD!",
    required=False
)

get_parser.add_argument(
    'end_time',
    type=inputs.date,
    location='args', #<--- forces code to check url for args
    help="The event date with the correct format is required! The correct format is YYYY-MM-DD!",
    required=False
)

parser.add_argument(
    'event',
    type=str,
    help="The event name is required!",
    required=True
)


api.add_resource(HelloWorld, '/hello')
api.add_resource(Events, '/event/today')
api.add_resource(HelloWorldResource, '/event')
api.add_resource(EventByID, '/event/<int:event_id>')



# do not change the way you run the program
if __name__ == '__main__':
    if len(sys.argv) > 1:
        arg_host, arg_port = sys.argv[1].split(':')
        app.run(host=arg_host, port=arg_port)
    else:
        app.run()
