CREATE TRIGGER update_inventory
AFTER INSERT ON sales
FOR EACH ROW
BEGIN
	UPDATE 
		inventory
	SET
		quantity = quantity - NEW.quantity,
		last_inventory_date = NEW.sale_date
	WHERE
		product_id = NEW.product_id;
END; //

