WITH car AS (
	SELECT
		product_id,
		model,
		price
	FROM products
	GROUP BY
		model,
		price,
		product_id
),
total_sales AS (
	SELECT
		product_id,
		SUM(total_price) AS total_sale_per_model
	FROM sales
	GROUP BY
		product_id
),
inventory_totals AS (
	SELECT
		product_id,
		SUM(quantity) AS inventory_per_model
	FROM inventory
	GROUP BY
		product_id
)
SELECT
	car.model,
	car.price,
	total_sales.total_sale_per_model,
	inventory_totals.inventory_per_model,
	CAST(
		CAST(total_sales.total_sale_per_model AS FLOAT) / NULLIF(inventory_totals.quantity2, 0) 
		AS DECIMAL(18, 4)
	) AS sales_inventory_ratio
FROM car
INNER JOIN total_sales
	ON car.product_id = total_sales.product_id
INNER JOIN inventory_totals
	ON total_sales.product_id = inventory_totals.product_id
ORDER BY
	sales_inventory_ratio DESC;
