WITH monthly_sales AS (
    SELECT 
        employee_id,
        DATE_FORMAT(sale_date, '%M %Y') AS month_year,
        (SUM(quantity) / SUM(SUM(quantity)) OVER()) * 100 AS sales_percentage
    FROM sales
    GROUP BY 
        employee_id, 
        month_year
),
employee_monthly_bonus AS (
    SELECT 
        employee_id,
        month_year,
        CASE
            WHEN sales_percentage < 5 THEN 0
            WHEN sales_percentage >= 5 AND sales_percentage < 10 THEN 2000
            WHEN sales_percentage >= 10 AND sales_percentage < 20 THEN 5000
            WHEN sales_percentage >= 20 AND sales_percentage < 30 THEN 10000
            WHEN sales_percentage >= 30 AND sales_percentage <= 40 THEN 15000
            ELSE 25000
        END AS employee_bonus
    FROM monthly_sales
)
SELECT 
    CONCAT(employees.first_name, ' ', employees.last_name) AS employee_name,
    employees.position,
    employee_monthly_bonus.month_year,
    employee_monthly_bonus.employee_bonus
FROM employees
INNER JOIN employee_monthly_bonus 
    ON employees.employee_id = employee_monthly_bonus.employee_id
WHERE employees.position = 'Sales Associate';
